{
    "configurations": [
        {
            "name": "MacOS",
            "includePath": [
                "${workspaceFolder}/Pagoda/src",
                "${workspaceFolder}/Pagoda/vendor/spdlog/include",
                "${workspaceFolder}/Pagoda/vendor/glfw/include",
                "${workspaceFolder}/Pagoda/vendor/eigen",
                "${workspaceFolder}/Pagoda/vendor/glad/include",
                "${workspaceFolder}/Pagoda/vendor/lua/lua/include"
            ],
            "defines": [
                "PG_ENABLE_ASSERTS",
                "PG_PLATFORM_MACOS"
            ],
            "compilerPath": "/usr/bin/clang",
            "cStandard": "c17",
            "cppStandard": "c++17",
            "intelliSenseMode": "linux-clang-x64"
        }
    ],
    "version": 4
}